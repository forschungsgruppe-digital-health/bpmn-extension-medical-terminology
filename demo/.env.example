# Development-only target for the Vite proxy at /snowstorm-api.
# This value enables Snowstorm for `npm run dev` and is evaluated by vite.config.js.
# It is exposed to the browser, so it must not contain credentials or other secrets.
# It must be a redirect-free Snowstorm API base URL without /MAIN/concepts.
# VITE_SNOWSTORM_PROXY_TARGET=https://snowstorm.example.test/snowstorm/snomed-ct

# Optional direct Snowstorm URL. Use only when the target permits this browser
# origin through CORS. This is required to enable Snowstorm in static builds.
# VITE_SNOWSTORM_BASE_URL=https://snowstorm.example.test/snowstorm/snomed-ct

# Optional Snowstorm request settings.
# VITE_SNOWSTORM_BRANCH=MAIN
# VITE_SNOWSTORM_LANGUAGE=de
# VITE_SNOWSTORM_LANGUAGE_STRATEGY=header
# VITE_SNOWSTORM_DEFAULT_ECL=< 404684003
# VITE_SNOWSTORM_MAX_RESULTS=15

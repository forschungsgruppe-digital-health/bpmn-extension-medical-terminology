{
  "name": "clinical-bpmn",
  "private": true,
  "type": "module",
  "description": "Semantic medical terminology for BPMN process models",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forschungsgruppe-digital-health/bpmn-extension-medical-terminology.git"
  },
  "homepage": "https://github.com/forschungsgruppe-digital-health/bpmn-extension-medical-terminology#readme",
  "bugs": {
    "url": "https://github.com/forschungsgruppe-digital-health/bpmn-extension-medical-terminology/issues"
  },
  "scripts": {
    "dev": "npm run --workspace=demo dev",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:bpmn": "node tools/lint-bpmn.mjs",
    "lint:valid": "bpmnlint \"examples/valid/**/*.bpmn\"",
    "lint:invalid": "bpmnlint \"examples/invalid/**/*.bpmn\"",
    "check:roundtrip": "node tools/moddle-roundtrip.mjs",
    "check:xsd": "bash tools/validate-xsd.sh",
    "xsd:gen": "node tools/moddle-to-xsd.mjs",
    "xsd:gen:check": "node tools/moddle-to-xsd.mjs --check",
    "generate:hl7": "node tools/generate-hl7-code-systems.mjs",
    "generate:hl7:check": "node tools/generate-hl7-code-systems.mjs --check",
    "generate:terminology": "node extension/src/cli/generate-terminology-packages.js",
    "xsd:ext": "node tools/validate-xsd-ext.mjs",
    "check:packages": "node tools/check-package-conventions.mjs",
    "check:conformance": "npm run lint:bpmn && npm run check:roundtrip && npm run xsd:gen:check && npm run xsd:ext && npm run check:xsd",
    "verify": "npm run check:packages && npm run generate:hl7:check && npm run check:conformance && npm test",
    "hooks:install": "node tools/setup-hooks.mjs",
    "prepare": "node tools/setup-hooks.mjs"
  },
  "workspaces": [
    "extension",
    "demo",
    "extension/lint/bpmnlint-plugin-terminology"
  ],
  "devDependencies": {
    "@testing-library/preact": "^3.2.4",
    "@types/fhir": "^0.0.41",
    "@xmldom/xmldom": "^0.9.10",
    "bpmn-moddle": "^10.0.0",
    "bpmnlint": "^11.12.1",
    "jsdom": "^26.1.0",
    "vitest": "^3.1.1"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  }
}

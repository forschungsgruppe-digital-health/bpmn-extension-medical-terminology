{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "pull-request-title-pattern": "chore${scope}: release${component} ${version}",
  "packages": {
    "extension": {
      "component": "terminology",
      "release-type": "node",
      "release-as": "1.0.0-rc.1",
      "prerelease": true,
      "prerelease-type": "rc",
      "extra-files": [
        {
          "type": "json",
          "path": "lint/bpmnlint-plugin-terminology/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "src/moddle/medical-terminology.json",
          "jsonpath": "$.version"
        },
        "/schema/medical-terminology.xsd",
        {
          "type": "yaml",
          "path": "/CITATION.cff",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "/codemeta.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "/package-lock.json",
          "jsonpath": "$.packages['extension'].version"
        },
        {
          "type": "json",
          "path": "/package-lock.json",
          "jsonpath": "$.packages['extension/lint/bpmnlint-plugin-terminology'].version"
        }
      ]
    }
  },
  "plugins": [
    {
      "type": "node-workspace",
      "updatePeerDependencies": true,
      "merge": false
    }
  ],
  "include-component-in-tag": true,
  "separate-pull-requests": true
}

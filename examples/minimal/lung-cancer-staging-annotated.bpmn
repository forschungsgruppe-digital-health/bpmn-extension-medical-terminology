<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions
    xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:term="https://clinical-bpmn.org/terminology/v1"
    xmlns:fhirmap="https://clinical-bpmn.org/fhir-mapping/v1"
    id="Definitions_Minimal_Annotated"
    targetNamespace="https://clinical-bpmn.org/examples/minimal"
    exporter="bpmn-js-clinical-semantics"
    exporterVersion="0.1.0">

  <!-- ============================================================
       Annotated BPMN Example: Lung Cancer Treatment Decision
       ============================================================

       Same process as lung-cancer-staging.bpmn, enriched with:

       1. term:annotations — clinical terminology annotations
          (SNOMED CT, LOINC, OPS codes on each task)

       2. fhirmap:resourceMappings — FHIR R4 resource mappings
          (resourceType, profile, interaction, direction,
           keyElements with FHIRPath and semantic roles)

       The fhirmap: extensions map each BPMN element to its
       corresponding FHIR resource in lung-cancer-staging-fhir.json:

         BPMN Element        → FHIR Resource
         ─────────────────────────────────────────────────────
         Task_Staging         → Observation (TNM stage output)
                                ServiceRequest (staging order)
         DataObj_MRI          → DocumentReference (MRI report, input)
         Gateway_Split        → PlanDefinition.action (selectionBehavior)
         Task_Surgery         → Procedure (lobectomy)
         Task_Chemo           → MedicationRequest (cisplatin)
         Task_Followup        → CarePlan (follow-up plan)
         DataObj_DischargeLetter → DocumentReference (discharge letter, output)

       The term: and fhirmap: namespaces are fully independent.
       Non-clinical BPMN tools will ignore both and preserve them
       on re-save (standard extensionElements behavior).
       ============================================================ -->

  <bpmn2:process id="Process_LungCaMin" name="Lung Cancer Treatment Decision" isExecutable="false">

    <!-- ─── Start Event ─────────────────────────────────────── -->
    <bpmn2:startEvent id="StartEvent_1" name="Patient with suspected lung cancer">
      <bpmn2:outgoing>Flow_Start_Staging</bpmn2:outgoing>
    </bpmn2:startEvent>

    <!-- ─── Data Object: MRI Scan Report (input to staging) ─── -->
    <bpmn2:dataObjectReference id="DataObj_MRI" name="MRI Scan Report" term:clinicalDomain="diagnostics">
      <bpmn2:extensionElements>

        <term:annotations>
          <term:annotation id="term-ann-1"
                           text="MRI scan report of the thorax as input document for TNM staging">
            <term:coding system="http://loinc.org" code="18748-4"
                         display="Diagnostic imaging study"/>
            <term:coding system="http://ihe-d.de/CodeSystems/IHEXDStypeCode" version="2020-02-07T07:55:58" code="ERGE"
                         display="Diagnostic imaging results"/>
          </term:annotation>
          <term:annotation id="term-ann-2">
            <term:coding system="http://ihe-d.de/CodeSystems/IHEXDSclassCode" version="2021-06-25T13:44:47" code="BEF"
                         display="Clinical reports"/>
          </term:annotation>
        </term:annotations>

        <fhirmap:resourceMappings>
          <fhirmap:resourceMapping resourceType="DocumentReference"
                                   profile="http://hl7.org/fhir/StructureDefinition/DocumentReference"
                                   interaction="read"
                                   direction="input">
            <fhirmap:keyElement path="DocumentReference.type"
                               semanticRole="classifier"
                               terminologyBinding="term-ann-1"/>
            <fhirmap:keyElement path="DocumentReference.category"
                               semanticRole="classifier"
                               terminologyBinding="term-ann-2"/>
            <fhirmap:keyElement path="DocumentReference.status"
                               semanticRole="trigger"
                               fixedValue="current"/>
            <fhirmap:keyElement path="DocumentReference.content.attachment.contentType"
                               semanticRole="payload"
                               fixedValue="application/pdf"/>
          </fhirmap:resourceMapping>
        </fhirmap:resourceMappings>

      </bpmn2:extensionElements>
    </bpmn2:dataObjectReference>

    <!-- ─── Task: TNM Staging ───────────────────────────────── -->
    <bpmn2:task id="Task_Staging" name="Perform TNM Staging" term:clinicalDomain="staging">
      <bpmn2:extensionElements>

        <!-- Terminology annotations -->
        <term:annotations>
          <term:annotation id="term-ann-3" mode="descriptive"
                           text="Clinical TNM staging to determine tumor stage">
            <term:coding system="http://snomed.info/sct" code="254292007"
                         display="Tumor staging (tumor staging)"/>
            <term:coding system="http://loinc.org" code="21908-9"
                         display="Stage group.clinical Cancer"/>
          </term:annotation>
        </term:annotations>

        <!-- FHIR resource mappings -->
        <fhirmap:resourceMappings>

          <!-- Primary output: Observation with TNM stage -->
          <fhirmap:resourceMapping resourceType="Observation"
                                   profile="http://hl7.org/fhir/StructureDefinition/Observation"
                                   interaction="create"
                                   direction="output">
            <fhirmap:keyElement path="Observation.code"
                               semanticRole="classifier"
                               terminologyBinding="term-ann-3"/>
            <fhirmap:keyElement path="Observation.valueCodeableConcept"
                               semanticRole="payload"
                               terminologyBinding="term-ann-3"/>
            <fhirmap:keyElement path="Observation.status"
                               semanticRole="trigger"
                               fixedValue="final"/>
          </fhirmap:resourceMapping>

          <!-- The staging task also generates a ServiceRequest -->
          <fhirmap:resourceMapping resourceType="ServiceRequest"
                                   interaction="create"
                                   direction="output">
            <fhirmap:keyElement path="ServiceRequest.code"
                               semanticRole="classifier"
                               terminologyBinding="term-ann-3"/>
            <fhirmap:keyElement path="ServiceRequest.intent"
                               semanticRole="classifier"
                               fixedValue="order"/>
          </fhirmap:resourceMapping>

        </fhirmap:resourceMappings>

      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_Start_Staging</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Staging_GwSplit</bpmn2:outgoing>
      <bpmn2:dataInputAssociation id="DataInputAssoc_MRI">
        <bpmn2:sourceRef>DataObj_MRI</bpmn2:sourceRef>
      </bpmn2:dataInputAssociation>
    </bpmn2:task>

    <!-- ─── XOR Gateway: Split ──────────────────────────────── -->
    <bpmn2:exclusiveGateway id="Gateway_Split" name="Tumor Stage?">
      <bpmn2:extensionElements>

        <term:annotations>
          <term:annotation id="term-ann-4" mode="descriptive"
                           text="Treatment decision based on TNM stage: Stage I-II (operable) vs. Stage III-IV (inoperable)"/>
        </term:annotations>

      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_Staging_GwSplit</bpmn2:incoming>
      <bpmn2:outgoing>Flow_GwSplit_Surgery</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_GwSplit_Chemo</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>

    <!-- ─── Task: Surgical Resection (path A) ───────────────── -->
    <bpmn2:task id="Task_Surgery" name="Surgical Resection" term:clinicalDomain="therapy">
      <bpmn2:extensionElements>

        <term:annotations>
          <term:annotation id="term-ann-5" mode="prescriptive"
                           text="Lobectomy or pneumonectomy for operable lung cancer Stage I-II">
            <term:coding system="http://snomed.info/sct" code="359615001"
                         display="Partial lobectomy of lung (procedure)"/>
            <term:coding system="http://fhir.de/CodeSystem/bfarm/ops" version="2021" code="5-324"
                         display="Simple lobectomy and bilobectomy of the lung"/>
          </term:annotation>
        </term:annotations>

        <fhirmap:resourceMappings>
          <fhirmap:resourceMapping resourceType="Procedure"
                                   profile="http://hl7.org/fhir/StructureDefinition/Procedure"
                                   interaction="create"
                                   direction="output">
            <fhirmap:keyElement path="Procedure.code"
                               semanticRole="classifier"
                               terminologyBinding="term-ann-5"/>
            <fhirmap:keyElement path="Procedure.bodySite"
                               semanticRole="payload"
                               terminologyBinding="term-ann-5"/>
            <fhirmap:keyElement path="Procedure.status"
                               semanticRole="trigger"
                               fixedValue="completed"/>
          </fhirmap:resourceMapping>
        </fhirmap:resourceMappings>

      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_GwSplit_Surgery</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Surgery_GwJoin</bpmn2:outgoing>
    </bpmn2:task>

    <!-- ─── Task: Systemic Chemotherapy (path B) ────────────── -->
    <bpmn2:task id="Task_Chemo" name="Systemic Chemotherapy" term:clinicalDomain="therapy">
      <bpmn2:extensionElements>

        <term:annotations>
          <term:annotation id="term-ann-6" mode="prescriptive"
                           text="Cisplatin-based doublet chemotherapy for inoperable lung cancer Stage III-IV">
            <term:coding system="http://snomed.info/sct" code="367336001"
                         display="Chemotherapy (procedure)"/>
            <term:coding system="http://www.whocc.no/atc" version="2025.0.0" code="L01XA01"
                         display="Cisplatin"/>
          </term:annotation>
        </term:annotations>

        <fhirmap:resourceMappings>
          <fhirmap:resourceMapping resourceType="MedicationRequest"
                                   profile="http://hl7.org/fhir/StructureDefinition/MedicationRequest"
                                   interaction="create"
                                   direction="output">
            <fhirmap:keyElement path="MedicationRequest.medicationCodeableConcept"
                               semanticRole="payload"
                               terminologyBinding="term-ann-6"/>
            <fhirmap:keyElement path="MedicationRequest.intent"
                               semanticRole="classifier"
                               fixedValue="order"/>
            <fhirmap:keyElement path="MedicationRequest.status"
                               semanticRole="trigger"
                               fixedValue="active"/>
          </fhirmap:resourceMapping>
        </fhirmap:resourceMappings>

      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_GwSplit_Chemo</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Chemo_GwJoin</bpmn2:outgoing>
    </bpmn2:task>

    <!-- ─── XOR Gateway: Join ───────────────────────────────── -->
    <bpmn2:exclusiveGateway id="Gateway_Join">
      <bpmn2:incoming>Flow_Surgery_GwJoin</bpmn2:incoming>
      <bpmn2:incoming>Flow_Chemo_GwJoin</bpmn2:incoming>
      <bpmn2:outgoing>Flow_GwJoin_Followup</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>

    <!-- ─── Data Object: Discharge Letter (output of follow-up) -->
    <bpmn2:dataObjectReference id="DataObj_DischargeLetter" name="Discharge Letter" term:clinicalDomain="documentation">
      <bpmn2:extensionElements>

        <term:annotations>
          <term:annotation id="term-ann-7" mode="prescriptive"
                           text="Medical discharge report upon completion of follow-up">
            <term:coding system="http://loinc.org" code="18842-5"
                         display="Discharge summary"/>
            <term:coding system="http://dvmd.de/fhir/CodeSystem/kdl" version="2024" code="AD010101"
                         display="Medical discharge report"/>
          </term:annotation>
          <term:annotation id="term-ann-8" mode="prescriptive">
            <term:coding system="http://ihe-d.de/CodeSystems/IHEXDSclassCode" version="2021-06-25T13:44:47" code="BRI"
                         display="Physician letters"/>
          </term:annotation>
        </term:annotations>

        <fhirmap:resourceMappings>
          <fhirmap:resourceMapping resourceType="DocumentReference"
                                   profile="http://hl7.org/fhir/StructureDefinition/DocumentReference"
                                   interaction="create"
                                   direction="output">
            <fhirmap:keyElement path="DocumentReference.type"
                               semanticRole="classifier"
                               terminologyBinding="term-ann-7"/>
            <fhirmap:keyElement path="DocumentReference.category"
                               semanticRole="classifier"
                               terminologyBinding="term-ann-8"/>
            <fhirmap:keyElement path="DocumentReference.status"
                               semanticRole="trigger"
                               fixedValue="current"/>
            <fhirmap:keyElement path="DocumentReference.content.attachment.contentType"
                               semanticRole="payload"
                               fixedValue="application/pdf"/>
          </fhirmap:resourceMapping>
        </fhirmap:resourceMappings>

      </bpmn2:extensionElements>
    </bpmn2:dataObjectReference>

    <!-- ─── Task: Follow-up Assessment ──────────────────────── -->
    <bpmn2:task id="Task_Followup" name="Follow-up Assessment" term:clinicalDomain="follow-up">
      <bpmn2:extensionElements>

        <term:annotations>
          <term:annotation id="term-ann-9" mode="descriptive"
                           text="Structured follow-up assessment with imaging surveillance and lab monitoring">
            <term:coding system="http://snomed.info/sct" code="390906007"
                         display="Follow-up encounter (procedure)"/>
            <term:coding system="http://loinc.org" code="18776-5"
                         display="Plan of care note"/>
          </term:annotation>
        </term:annotations>

        <fhirmap:resourceMappings>
          <fhirmap:resourceMapping resourceType="CarePlan"
                                   profile="http://hl7.org/fhir/StructureDefinition/CarePlan"
                                   interaction="create"
                                   direction="output">
            <fhirmap:keyElement path="CarePlan.status"
                               semanticRole="trigger"
                               fixedValue="active"/>
            <fhirmap:keyElement path="CarePlan.intent"
                               semanticRole="classifier"
                               fixedValue="plan"/>
            <fhirmap:keyElement path="CarePlan.category"
                               semanticRole="classifier"
                               terminologyBinding="term-ann-9"/>
            <fhirmap:keyElement path="CarePlan.title"
                               semanticRole="payload"
                               fixedValue="Follow-up Lung Cancer"/>
          </fhirmap:resourceMapping>
        </fhirmap:resourceMappings>

      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_GwJoin_Followup</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Followup_End</bpmn2:outgoing>
      <bpmn2:dataOutputAssociation id="DataOutputAssoc_DischargeLetter">
        <bpmn2:targetRef>DataObj_DischargeLetter</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:task>

    <!-- ─── End Event ───────────────────────────────────────── -->
    <bpmn2:endEvent id="EndEvent_1" name="Treatment plan completed">
      <bpmn2:incoming>Flow_Followup_End</bpmn2:incoming>
    </bpmn2:endEvent>

    <!-- ─── Sequence Flows ──────────────────────────────────── -->
    <bpmn2:sequenceFlow id="Flow_Start_Staging" sourceRef="StartEvent_1" targetRef="Task_Staging"/>
    <bpmn2:sequenceFlow id="Flow_Staging_GwSplit" sourceRef="Task_Staging" targetRef="Gateway_Split"/>
    <bpmn2:sequenceFlow id="Flow_GwSplit_Surgery" name="Stage I-II (operable)" sourceRef="Gateway_Split" targetRef="Task_Surgery"/>
    <bpmn2:sequenceFlow id="Flow_GwSplit_Chemo" name="Stage III-IV (inoperable)" sourceRef="Gateway_Split" targetRef="Task_Chemo"/>
    <bpmn2:sequenceFlow id="Flow_Surgery_GwJoin" sourceRef="Task_Surgery" targetRef="Gateway_Join"/>
    <bpmn2:sequenceFlow id="Flow_Chemo_GwJoin" sourceRef="Task_Chemo" targetRef="Gateway_Join"/>
    <bpmn2:sequenceFlow id="Flow_GwJoin_Followup" sourceRef="Gateway_Join" targetRef="Task_Followup"/>
    <bpmn2:sequenceFlow id="Flow_Followup_End" sourceRef="Task_Followup" targetRef="EndEvent_1"/>

  </bpmn2:process>

  <!-- ─── Diagram Layout ──────────────────────────────────────── -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_LungCaMin">

      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="160" y="222" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="134" y="265" width="89" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="DataObj_MRI_di" bpmnElement="DataObj_MRI">
        <dc:Bounds x="292" y="95" width="36" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="270" y="65" width="80" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Staging_di" bpmnElement="Task_Staging">
        <dc:Bounds x="260" y="200" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_Split_di" bpmnElement="Gateway_Split" isMarkerVisible="true">
        <dc:Bounds x="425" y="215" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="415" y="191" width="70" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Surgery_di" bpmnElement="Task_Surgery">
        <dc:Bounds x="540" y="120" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Chemo_di" bpmnElement="Task_Chemo">
        <dc:Bounds x="540" y="290" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_Join_di" bpmnElement="Gateway_Join" isMarkerVisible="true">
        <dc:Bounds x="705" y="215" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_Followup_di" bpmnElement="Task_Followup">
        <dc:Bounds x="820" y="200" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="DataObj_DischargeLetter_di" bpmnElement="DataObj_DischargeLetter">
        <dc:Bounds x="852" y="95" width="36" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="838" y="65" width="64" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="992" y="222" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="966" y="265" width="89" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_Start_Staging_di" bpmnElement="Flow_Start_Staging">
        <di:waypoint x="196" y="240"/>
        <di:waypoint x="260" y="240"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Staging_GwSplit_di" bpmnElement="Flow_Staging_GwSplit">
        <di:waypoint x="360" y="240"/>
        <di:waypoint x="425" y="240"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_GwSplit_Surgery_di" bpmnElement="Flow_GwSplit_Surgery">
        <di:waypoint x="450" y="215"/>
        <di:waypoint x="450" y="160"/>
        <di:waypoint x="540" y="160"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="456" y="143" width="80" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_GwSplit_Chemo_di" bpmnElement="Flow_GwSplit_Chemo">
        <di:waypoint x="450" y="265"/>
        <di:waypoint x="450" y="330"/>
        <di:waypoint x="540" y="330"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="456" y="335" width="80" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Surgery_GwJoin_di" bpmnElement="Flow_Surgery_GwJoin">
        <di:waypoint x="640" y="160"/>
        <di:waypoint x="730" y="160"/>
        <di:waypoint x="730" y="215"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Chemo_GwJoin_di" bpmnElement="Flow_Chemo_GwJoin">
        <di:waypoint x="640" y="330"/>
        <di:waypoint x="730" y="330"/>
        <di:waypoint x="730" y="265"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_GwJoin_Followup_di" bpmnElement="Flow_GwJoin_Followup">
        <di:waypoint x="755" y="240"/>
        <di:waypoint x="820" y="240"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_Followup_End_di" bpmnElement="Flow_Followup_End">
        <di:waypoint x="920" y="240"/>
        <di:waypoint x="992" y="240"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="DataInputAssoc_MRI_di" bpmnElement="DataInputAssoc_MRI">
        <di:waypoint x="310" y="145"/>
        <di:waypoint x="310" y="200"/>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="DataOutputAssoc_DischargeLetter_di" bpmnElement="DataOutputAssoc_DischargeLetter">
        <di:waypoint x="870" y="200"/>
        <di:waypoint x="870" y="145"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn2:definitions>
